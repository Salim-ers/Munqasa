# Copier vers .env.local (ignoré par Git) et renseigner.
#
# ─── Variables SERVEUR uniquement ───────────────────────────────────────────
# Ne jamais les préfixer par VITE_ : Vite les injecterait dans le bundle.

# Génération d'images (outil de production, jamais appelé par le site public)
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1

# Formulaire de contact — envoi via l'API Resend (https://resend.com)
RESEND_API_KEY=
# Adresse qui reçoit les demandes
CONTACT_TO=
# Expéditeur vérifié dans Resend, ex. "MUNAQASA <formulaire@votre-domaine.ma>"
CONTACT_FROM=

# ─── Variable publique (non secrète) ────────────────────────────────────────
# URL canonique du site, sans slash final (canonical, sitemap, Open Graph)
VITE_SITE_URL=https://munaqasa.ma

# Copier vers .env.local (ignoré par Git) et renseigner.
#
# ─── Variables SERVEUR uniquement ───────────────────────────────────────────
# Ne jamais les préfixer par VITE_ : Vite les injecterait dans le bundle.

# API OpenAI : agents de l'espace d'administration et outils de génération d'images.
# Jamais appelée par le site public, jamais exposée au navigateur.
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1

# Formulaire de contact — envoi via l'API Resend (https://resend.com)
RESEND_API_KEY=
# Adresse qui reçoit les demandes
CONTACT_TO=
# Expéditeur vérifié dans Resend, ex. "Talab Solutions <formulaire@votre-domaine.ma>"
CONTACT_FROM=

# ─── Espace d'administration (serveur uniquement) ───────────────────────────
# Neon PostgreSQL : chaîne de connexion (Vercel > Storage > Neon, ou console Neon).
# Sans elle, en local, une base PostgreSQL embarquée (PGlite) est utilisée dans .data/.
DATABASE_URL=
# Secret de signature des sessions : 32 caractères au moins (ex. : openssl rand -base64 48).
BETTER_AUTH_SECRET=
# Adresse de l'unique compte administrateur.
ADMIN_EMAIL=
# URL publique du site, sans barre finale (ex. https://munqasa.vercel.app). Déduite sur Vercel si absente.
APP_URL=
# Secret de la tâche planifiée quotidienne (Vercel Cron) : rappels d'échéance, nettoyage. Ex. : openssl rand -hex 32
CRON_SECRET=
# Stockage objet compatible S3 (Cloudflare R2), compartiment PRIVÉ pour les plans et les exports.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Développement local uniquement (sans DATABASE_URL ni S3) :
# LOCAL_DB_DIR=.data/pglite
# LOCAL_STORAGE_DIR=.data/storage
# Prévisualisation du build (NODE_ENV=production) avec la base et le stockage locaux :
# TALAB_LOCAL=1

# ─── Variable publique (non secrète) ────────────────────────────────────────
# URL canonique du site, sans slash final (canonical, sitemap, Open Graph)
VITE_SITE_URL=https://talabsolutions.ma
